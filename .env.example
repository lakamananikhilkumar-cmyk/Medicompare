# MediCompare Environment Variables Blueprint
# Copy this file to .env and populate with your credentials.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=your_jwt_session_secret_key_here
ADMIN_EMAIL=admin@medicompare.com

# Google Gemini API (Server-Side Only - never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_STORAGE_BUCKET=prescriptions

# Optional Direct PostgreSQL Database URL (Supabase or external PostgreSQL)
# Leave blank to use zero-setup embedded in-memory PostgreSQL engine (PGlite)
DATABASE_URL=
